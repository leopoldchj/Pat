# Copy this file to `.env` at the project root and fill in the values.
# This single file is used by the Django backend, Docker Compose,
# and the React dev server (via `npm start` / `npm run dev`).

# --- Django ---
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=127.0.0.1,localhost
ALLOWED_CORS=http://localhost,http://localhost:3000

# --- Mail (SMTP) ---
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=user@example.com
MAIL_PASSWORD=change-me

# --- Database ---
DATABASE_NAME=my_db
DATABASE_USERNAME=my_user
DATABASE_PASSWORD=change-me
DATABASE_HOST=localhost
DATABASE_PORT=3306
# Set to True to use a local database instead of the configured host
#USE_LOCAL_DB=True

# --- Redis (WebSockets/Channels) ---
# Defaults to localhost; Docker Compose overrides it to `redis`
#REDIS_HOST=localhost

# --- AWS S3 (photo storage) ---
AWS_ACCESS_KEY=AKIA...
AWS_ACCESS_SECRET=change-me
AWS_REGION=eu-west-3
AWS_BUCKET_NAME=my-bucket
# Set to something other than AWS to disable S3 storage (defaults to AWS)
#PHOTO_STORAGE_TYPE=AWS

# --- Frontend (local dev only — injected by `npm start` / `npm run dev`) ---
REACT_APP_API_URL=http://127.0.0.1:8000/api/
REACT_APP_WS_URL=ws://127.0.0.1:8000/ws/
